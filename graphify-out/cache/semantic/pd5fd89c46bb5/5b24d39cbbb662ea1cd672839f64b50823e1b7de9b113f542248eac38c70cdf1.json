{"nodes": [{"id": "claude_skills_graphify_skill_md", "label": "Graphify Skill (Main)", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_pipeline", "label": "Graphify Pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns any folder of files into a navigable knowledge graph with community detection, audit trail, and three outputs: HTML viz, GraphRAG JSON, and GRAPH_REPORT.md."}, {"id": "detection_concept", "label": "File Detection", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 1 of pipeline. Classifies files into code, document, paper, image, video categories using graphify.detect module."}, {"id": "ast_extraction_concept", "label": "AST Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Part A of Step 3. Deterministic, free, no LLM. Extracts code structure from code files via Python AST. Runs in parallel with semantic extraction."}, {"id": "semantic_extraction_concept", "label": "Semantic Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Part B of Step 3. LLM-based extraction for docs, papers, images. Uses Gemini if API key set, otherwise host agent. Dispatches parallel subagents."}, {"id": "extraction_merge_concept", "label": "Extraction Merge", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Part C of Step 3. Merges AST extraction (code) and semantic extraction (docs/papers/images) into unified .graphify_extract.json."}, {"id": "community_detection_concept", "label": "Community Detection", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 4. Uses Louvain clustering via graspologic (or NetworkX fallback) to partition graph into communities. Surfaces cross-document connections."}, {"id": "god_nodes_concept", "label": "God Nodes", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highly connected nodes that bridge multiple communities. Identified by degree centrality analysis. Surface the most important entities in the corpus."}, {"id": "html_visualization_concept", "label": "HTML Visualization", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 6 output. Interactive HTML graph. Auto-aggregates to community view if graph exceeds 5000 nodes."}, {"id": "graph_report_concept", "label": "GRAPH_REPORT.md", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 5 output. Plain-language audit report with god nodes, surprising connections, and suggested questions."}, {"id": "community_labeling_concept", "label": "Community Labeling", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 5. Agent assigns 2-5 word plain-language names to each community cluster based on node labels."}, {"id": "extraction_cache_concept", "label": "Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caches semantic extraction results keyed by file + prompt hash. Re-extracts when prompt changes (graphify upgrade). Step B0 checks before dispatching."}, {"id": "shrink_guard_concept", "label": "Shrink Guard", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refuses to write graph.json if new graph has fewer nodes than existing. Prevents accidental data loss (#479). Override with --force."}, {"id": "honesty_rules_concept", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent edges, never skip corpus check, always show token cost, never hide cohesion scores, never run HTML viz >5000 nodes without warning."}, {"id": "manifest_concept", "label": "Manifest", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 9 saves manifest via save_manifest(). Only stamps semantic files that actually produced output. Keys relativized to scan root."}, {"id": "cost_tracking_concept", "label": "Cost Tracking", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 9 tracks cumulative token costs in graphify-out/cost.json. Shows per-run and all-time totals."}], "edges": [{"source": "claude_skills_graphify_skill_md", "target": "graphify_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "detection_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "ast_extraction_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "semantic_extraction_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "extraction_merge_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "community_detection_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "god_nodes_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_skill_md", "target": "html_visualization_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1